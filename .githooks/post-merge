#!/bin/sh

set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$REPO_ROOT/scripts/auto-sync.ps1"
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/auto-sync.ps1"
else
  sh "$REPO_ROOT/scripts/auto-sync.sh"
fi
